# In-app Assistant (docs/assistant-chat.md). Without a key the panel says the assistant isn't available.
ANTHROPIC_API_KEY=
# Optional: another Messages API base URL, e.g. a local fake for testing.
# ASSISTANT_CHAT_UPSTREAM=http://127.0.0.1:8787
# Development only: run the Assistant on your Claude subscription through claude -p.
# ASSISTANT_DEV_CLAUDE=1
