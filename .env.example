# In-app Assistant (docs/assistant-chat.md). Without a key the panel says the assistant isn't available.
ANTHROPIC_API_KEY=
# Optional: another Messages API base URL, e.g. a local fake for testing.
# ASSISTANT_CHAT_UPSTREAM=http://127.0.0.1:8787
# Development only: run the Assistant on your Claude subscription through claude -p.
# ASSISTANT_DEV_CLAUDE=1

# Library sync with the user's own Google Drive or iCloud (docs/cloud-sync.md). Browser-only: these are
# public identifiers, not secrets, and no server is involved. Leave empty to hide a provider.
PUBLIC_GOOGLE_CLIENT_ID=
PUBLIC_CLOUDKIT_CONTAINER=
PUBLIC_CLOUDKIT_API_TOKEN=
# development (default) or production
PUBLIC_CLOUDKIT_ENVIRONMENT=
