# In-app Assistant (docs/assistant-chat.md). Without a key the panel says the assistant isn't available.
ANTHROPIC_API_KEY=
# Optional: another Messages API base URL, e.g. a local fake for testing.
# ASSISTANT_CHAT_UPSTREAM=http://127.0.0.1:8787
# Development only: run the Assistant on your Claude subscription through claude -p.
# ASSISTANT_DEV_CLAUDE=1
# Who may use the server's key: comma-separated Google account emails (sign-in through
# Firebase Auth). Unset under `npm run dev` keeps the assistant open without sign-in;
# unset in production turns the server's assistant off.
# ASSISTANT_ALLOWED_EMAILS=you@example.com,family@example.com
# Firebase project whose ID tokens are accepted (default openplan3d).
# ASSISTANT_FIREBASE_PROJECT=openplan3d
# Spending limit per signed-in person in US dollars, per UTC day and calendar month.
# Kept in HANDOFF_BUCKET when set, in memory otherwise.
# ASSISTANT_DAILY_USD=5
# ASSISTANT_MONTHLY_USD=50
